<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through cloud backup or device transfer: the data file holds
     secrets encrypted with a key that only exists in this device's keystore, so a copy would be
     unusable anyway. The app has its own explicit export instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
